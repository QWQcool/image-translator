# 会话签名密钥。生产环境务必替换为随机长字符串。
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=please-change-me-to-a-long-random-string

# 运行时数据目录（SQLite 数据库 + 上传的图片），相对于项目根目录
DATA_DIR=data

# 注册邀请码（过渡方案，管理员发放页面见后续）。生产环境未配置则拒绝所有注册。
INVITE_CODE=

# 本机 OCR / LaMa sidecar。未启动时 OCR 返回 503，去字降级为边界填色。
# SIDECAR_URL=http://127.0.0.1:8765

# ── 试用模式（仅限本机体验，勿用于公网部署）──────────────────────────────
# 置 1 后所有请求自动以内置体验用户（username=trial）访问：无登录墙、
# 登录/注册页不可达、体验用户不可登出也非管理员。数据全部落在本机 DATA_DIR。
# 注意：middleware（Edge runtime）中的 TRIAL_MODE 在构建期内联，
# 需要在 npm run build 之前设置才对登录墙生效（体验版构建已内置此逻辑）。
# 正式部署严禁开启此变量（默认留空即关闭）。
# TRIAL_MODE=1
